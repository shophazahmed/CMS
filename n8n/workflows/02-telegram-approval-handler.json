        "query": "INSERT INTO content_queue (campaign_id, created_by, source, fb_copy, twitter_copy, media_url, status)\nVALUES ((SELECT id FROM campaigns WHERE is_active ORDER BY priority DESC, id LIMIT 1),\n        'TEAM_MEMBER', 'MANUAL_TEAM', $1, $2, NULLIF($3, ''), 'PENDING_APPROVAL')\nRETURNING id AS post_id, 'preview' AS mode;",
        "options": {
          "queryReplacement": "={{ [$json.facebook, $json.twitter, $json.media_url] }}"
        }
      },
