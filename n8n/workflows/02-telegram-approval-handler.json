    {
      "id": "7d62f673-3bb8-5674-938a-06d752e4521c",
      "name": "Parse Edited Copy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        1160
      ],
      "parameters": {
        "jsCode": "const t = $input.first().json.text;\nconst tw = t.match(/^\\s*TW:\\s*([\\s\\S]*?)(?=^\\s*FB:|$(?![\\s\\S]))/m);\nconst fb = t.match(/^\\s*FB:\\s*([\\s\\S]*?)(?=^\\s*TW:|$(?![\\s\\S]))/m);\nlet twitter = tw ? tw[1].trim() : '';\nlet facebook = fb ? fb[1].trim() : '';\nif (!tw && !fb) { twitter = t; facebook = t; }\nif ([...twitter].length > 280) twitter = [...twitter].slice(0, 279).join('').replace(/\\s+\\S*$/, '') + '…';\nreturn [{ json: { reply_to: $input.first().json.reply_to_message_id, twitter, facebook } }];\n"
      }
    },
    {
      "id": "99a0f97e-5b30-5613-b28f-20be086f8a47",
      "name": "Apply Edit",
      "type": "n8n-nodes-base.postgres",
