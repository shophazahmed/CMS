    {
      "id": "8b8e6f1f-bfe6-550d-915e-6ee7176adb2b",
      "name": "Format Publish Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1480,
        -400
      ],
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst r = $input.first().json;\nconst p = $('Parse Update').first().json;\nconst handle = $env.TWITTER_USERNAME || 'i';\nconst lines = [];\nif (r.fb_post_id) lines.push(`📘 FB post: ${esc(r.fb_post_id)}`);\nif (r.tweet_id) lines.push(`🐦 X: https://x.com/${handle}/status/${r.tweet_id}`);\nconst head = r.status === 'PUBLISHED'\n  ? `✅ <b>Published</b> by ${esc(p.user_name)}`\n  : `⚠️ <b>Publishing failed</b> (draft #${r.id}): ${esc(r.error_message || 'unknown error')}`;\nreturn [{ json: { text: esc(p.original_text) + '\\n\\n' + head + (lines.length ? '\\n' + lines.join('\\n') : '') } }];\n"
      }
    },
