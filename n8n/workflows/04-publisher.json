          "timeout": 60000
        }
      }
    },
    {
      "id": "9eec28bf-2063-5c23-8cd5-43588e29d7b6",
      "name": "Media Ready",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "// Joins the three media branches. Binary (if any) stays on the item as \"data\".\nconst plan = $('Plan Publish').first().json;\nconst item = $input.first();\nconst hasBin = !!(item.binary && item.binary.data);\nreturn [{ json: { ...plan, has_binary: hasBin }, binary: hasBin ? item.binary : undefined }];\n"
      }
    },
