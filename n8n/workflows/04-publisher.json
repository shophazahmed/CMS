    },
    {
      "id": "8793dbfb-64d0-5553-85be-aa036185fd64",
      "name": "After Facebook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "jsCode": "// Join point: restore the plan + media binary for the X/Twitter step.\nconst ready = $('Media Ready').first();\nreturn [{ json: ready.json, binary: ready.binary }];\n"
      }
    },
    {
      "id": "aabeac11-2090-50b8-babd-f1af5f9071b0",
      "name": "Post to X?",
