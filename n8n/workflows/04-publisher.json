      "typeVersion": 4.2,
      "position": [
        2640,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWITTER_API_BASE_URL }}/2/media/upload",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth1Api",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "media",
              "inputDataFieldName": "data"
            },
            {
              "name": "media_category",
              "value": "tweet_image"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "oAuth1Api": {
          "id": "shCredXOAuth1001",
          "name": "X OAuth1 User Context"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "dd6b9e85-4a92-5998-9af9-6e0879eed819",
      "name": "Build Tweet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        200
      ],
      "parameters": {
        "jsCode": "const plan = $('Media Ready').first().json;\nconst body = { text: plan.post.twitter_copy };\nlet mediaError = '';\nif ($('X: Upload Media').isExecuted) {\n  const up = $('X: Upload Media').first().json;\n  const id = up?.data?.id || up?.media_id_string;\n  if (id) body.media = { media_ids: [String(id)] };\n  else mediaError = 'image upload failed, posted text only: ' + (up?.error?.message || JSON.stringify(up).slice(0, 200));\n}\nreturn [{ json: { tweet_body: body, media_error: mediaError } }];\n"
      }
    },
    {
      "id": "66d73863-df19-5d71-94f8-6864444f9c86",
      "name": "X: Create Tweet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWITTER_API_BASE_URL }}/2/tweets",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth1Api",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.tweet_body) }}"
      },
      "credentials": {
        "oAuth1Api": {
          "id": "shCredXOAuth1001",
          "name": "X OAuth1 User Context"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "9d9d9f12-d6b8-5739-99d2-acc699313e2a",
      "name": "Collect Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        300
      ],
      "parameters": {
        "jsCode": "const plan = $('Media Ready').first().json;\n// n8n wraps API errors as '400 - \"{\\\"error\\\":{\\\"message\\\":\\\"...\\\"}}\"'; keep the\n// status code and pull out the API's own message so Telegram/portal show plain text.\nconst errMsg = (r) => {\n  const m = String(r?.error?.message || r?.error?.description || r?.detail || JSON.stringify(r).slice(0, 300));\n  const inner = m.match(/\\\\?\"(?:message|detail)\\\\?\"\\s*:\\s*\\\\?\"((?:[^\"\\\\]|\\\\[^\"])+)/);\n  const code = (m.match(/^(\\d{3})\\b/) || [])[1];\n  return inner ? `${code ? code + ' - ' : ''}${inner[1].replace(/\\\\/g, '')}` : m;\n};\nconst res = { post_id: String(plan.post.id), fb_post_id: '', tweet_id: '', errors: [] };\n\nif (plan.do_fb) {\n  const node = $('FB: Photo Post (/photos)').isExecuted ? 'FB: Photo Post (/photos)'\n             : $('FB: Text Post (/feed)').isExecuted ? 'FB: Text Post (/feed)' : null;\n  const r = node ? $(node).first().json : null;\n  if (r && (r.post_id || r.id) && !r.error) res.fb_post_id = String(r.post_id || r.id);\n  else res.errors.push('Facebook: ' + (r ? errMsg(r) : 'not executed'));\n}\nif (plan.do_tw) {\n  const r = $('X: Create Tweet').isExecuted ? $('X: Create Tweet').first().json : null;\n  if (r?.data?.id) res.tweet_id = String(r.data.id);\n  else res.errors.push('X: ' + (r ? errMsg(r) : 'not executed'));\n  const b = $('Build Tweet').isExecuted ? $('Build Tweet').first().json : {};\n  if (b.media_error) res.errors.push('X: ' + b.media_error);\n}\nconst failed = (plan.do_fb && !res.fb_post_id) || (plan.do_tw && !res.tweet_id);\nres.status = failed ? 'FAILED' : 'PUBLISHED';\nres.error_message = res.errors.join(' | ');\nreturn [{ json: res }];\n"
      }
    },
    {
      "id": "a9204c2c-9358-53e5-aa40-cd234fb95ae0",
      "name": "Finalize Post",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        3520,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_queue\n   SET status = $2,\n       fb_post_id = NULLIF($3, ''),\n       tweet_id = NULLIF($4, ''),\n       error_message = NULLIF($5, ''),\n       published_at = CASE WHEN $2 = 'PUBLISHED' THEN now() ELSE published_at END\n WHERE id = $1::int\nRETURNING id, status, fb_post_id, tweet_id, error_message, published_at;",
        "options": {
          "queryReplacement": "={{ [$json.post_id, $json.status, $json.fb_post_id, $json.tweet_id, $json.error_message] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "shCredPostgres01",
          "name": "Social Hub DB"
        }
      }
    }
