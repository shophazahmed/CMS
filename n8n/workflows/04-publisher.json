    {
      "id": "08adeafa-d72a-5b88-9e83-b8d4e442e72f",
      "name": "Plan Publish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const p = $input.first().json;\nconst m = p.media_url || '';\nreturn [{ json: {\n  post: p,\n  do_fb: p.target_platform !== 'TWITTER_ONLY',\n  do_tw: p.target_platform !== 'FACEBOOK_ONLY',\n  media_kind: !m ? 0 : m.startsWith('tg://') ? 1 : 2,   // 0 none, 1 telegram file, 2 url\n  tg_file_id: m.startsWith('tg://') ? m.slice(5) : '',\n  media_url: m.startsWith('tg://') ? '' : m,\n}}];\n"
      }
    },
    {
      "id": "f8a48971-d5f0-56c4-9dcd-ab62da1c7490",
      "name": "Media Source",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 3,
        "output": "={{ $json.media_kind }}"
      }
    },
    {
      "id": "de2b8395-429b-54f4-b9d1-8f0fb75b012c",
      "name": "Telegram: Download Photo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "resource": "file",
        "fileId": "={{ $json.tg_file_id }}",
        "download": true,
        "additionalFields": {}
