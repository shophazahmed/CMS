    },
    {
      "id": "9f4d2dd0-001b-5d78-9391-9d41887f67c0",
      "name": "Portal: Parse Adapt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        1080
      ],
      "parameters": {
        "jsCode": "function claudeJson(resp) {\n  if (resp.error) throw new Error('Claude API error: ' + JSON.stringify(resp.error).slice(0, 500));\n  if (resp.stop_reason === 'refusal') throw new Error('Claude declined this request (refusal).');\n  if (resp.stop_reason === 'max_tokens') throw new Error('Claude output was cut off (max_tokens).');\n  const block = (resp.content || []).find((b) => b.type === 'text');\n  if (!block) throw new Error('No text block in Claude response');\n  return JSON.parse(block.text);\n}\n\nconst o = claudeJson($input.first().json);\nlet tw = String(o.twitter_copy || '').trim();\nif ([...tw].length > 280) tw = [...tw].slice(0, 279).join('').replace(/\\s+\\S*$/, '') + '…';\nreturn [{ json: { ok: true, twitter_copy: tw, fb_copy: String(o.fb_copy || '').trim() } }];\n"
      }
    },
