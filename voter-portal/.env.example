# Copy to /etc/voter-portal/env (systemd) or .env (Docker). chmod 600.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
VOTER_PORTAL_SECRET_KEY=change-me
# Where the SQLite database and photos live
VOTER_PORTAL_DATA_DIR=/var/lib/voter-portal
# Gunicorn listen address (Nginx proxies to it)
GUNICORN_BIND=127.0.0.1:8001
